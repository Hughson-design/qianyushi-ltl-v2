# Supabase
# The publishable key is used only for Supabase Auth requests.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only. Never expose this value in browser code or commit it to GitHub.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Independent server-only quote signing key (random 32+ bytes). Configure before rotating Supabase keys.
QUOTE_SIGNING_KEY=YOUR_INDEPENDENT_RANDOM_SIGNING_KEY

# Priority1 sandbox
PRIORITY1_API_BASE=YOUR_PRIORITY1_SANDBOX_BASE_URL
PRIORITY1_API_KEY=YOUR_PRIORITY1_SANDBOX_API_KEY

# WWEX / SpeedShip sandbox
WWEX_AUTH_URL=YOUR_WWEX_SANDBOX_AUTH_URL
WWEX_CLIENT_ID=YOUR_WWEX_SANDBOX_CLIENT_ID
WWEX_CLIENT_SECRET=YOUR_WWEX_SANDBOX_CLIENT_SECRET
WWEX_AUDIENCE=YOUR_WWEX_SANDBOX_AUDIENCE
WWEX_API_BASE=YOUR_WWEX_SANDBOX_API_BASE_URL

# TQL (server-only; TQL currently issues production credentials)
TQL_AUTH_URL=https://public.api.tql.com/identity/token
TQL_API_BASE=https://public.api.tql.com/ltl
TQL_SUBSCRIPTION_KEY=YOUR_TQL_SUBSCRIPTION_KEY
TQL_CLIENT_ID=YOUR_TQL_CLIENT_ID
# public: newer API without client_secret; legacy requires the separately issued secret.
TQL_AUTH_MODE=public
TQL_CLIENT_SECRET=
TQL_USERNAME=YOUR_TQL_TRAX_USERNAME
TQL_PASSWORD=YOUR_TQL_TRAX_PASSWORD
TQL_SCOPE=https://tqlidentity.onmicrosoft.com/services_combined/LTLQuotes.Read https://tqlidentity.onmicrosoft.com/services_combined/LTLQuotes.Write https://tqlidentity.onmicrosoft.com/services_combined/LTLQuotes.Tender https://tqlidentity.onmicrosoft.com/services_combined/LoadTracking.Read
TQL_BOL_EMAIL=YOUR_OPERATIONS_EMAIL

# Shipment reader: server-only OpenAI credential (leave empty to disable paid AI).
OPENAI_API_KEY=
# Shipment reader model is pinned to gpt-6-luna in code; no model override.
